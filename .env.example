# Copy to .env and fill in. .env is gitignored — never commit it.
# Create your app at https://developer.yahoo.com/apps/create/
#   OAuth Client Type : Confidential Client  (this is what issues a secret)
#   Redirect URI(s)   : oob
#   API Permissions   : check neither box — the current form has no Fantasy
#                       Sports option. See README for what that means.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# 'oob' = paste the code by hand once. Leave as-is unless you registered a real
# https callback URL on your Yahoo app.
YAHOO_REDIRECT_URI=oob

# Where OAuth tokens live: 'keychain' (macOS Keychain, recommended) or 'file'
# ('file' writes .ffb_tokens.json with 0600 perms — gitignored either way).
FFB_TOKEN_STORE=keychain

# PIN for the LAN web dashboard (required when serving on 0.0.0.0).
FFB_PIN=
